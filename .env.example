MONGODB_URI=mongodb://127.0.0.1:27017/dholera-residential
PAYLOAD_SECRET=replace-with-a-long-random-payload-secret
BLOB_READ_WRITE_TOKEN=replace-with-your-vercel-blob-read-write-token

# Must exactly match ESTATE2_INGEST_SECRET in the Estate 2 environment.
ESTATE2_INGEST_SECRET=replace-with-a-long-random-secret

# Must exactly match ESTATE1_INGEST_SECRET in the Estate 1 frontend environment.
ESTATE1_INGEST_SECRET=replace-with-a-long-random-secret
DHOLERA_ESTATES_INGEST_SECRET=replace-with-a-long-random-secret
INDUSTRIAL_INGEST_SECRET=replace-with-a-long-random-secret

# Must exactly match OMANA_INGEST_SECRET in the Omana frontend environment.
OMANA_INGEST_SECRET=replace-with-a-long-random-secret

# Omana frontend cache invalidation after omana-blogs changes.
OMANA_FRONTEND_URL=https://omanaprojects.com
OMANA_REVALIDATE_SECRET=replace-with-a-different-long-random-secret

# Central RAG (server-only; never expose these through NEXT_PUBLIC_* variables).
OPENAI_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
RAG_INDEX_SECRET=
